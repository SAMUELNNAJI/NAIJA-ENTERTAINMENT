# Copy to .env and adjust for your environment.
# .env is git-ignored — never commit real secrets.

# Django settings (read by config/settings.py via python-dotenv)
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Production / Render -------------------------------------------------
# render.yaml sets DJANGO_DEBUG, DJANGO_SECRET_KEY (generated), DATABASE_URL
# and the Render hostname automatically; override only if you deploy by hand.
# DJANGO_DEBUG=0
# DJANGO_CSRF_TRUSTED_ORIGINS=https://your-site.onrender.com
# DATABASE_URL=postgres://user:pass@host:5432/dbname   # injected by Render
# MEDIA_ROOT=/opt/render/project/src/media             # persistent-disk path
# Optional superuser created/refreshed by `manage.py bootstrap_site`:
# DJANGO_SUPERUSER_USERNAME=admin
# DJANGO_SUPERUSER_PASSWORD=change-me
# DJANGO_SUPERUSER_EMAIL=admin@example.com
