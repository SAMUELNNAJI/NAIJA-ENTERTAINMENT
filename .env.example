# Copy to .env and adjust for your environment.
# .env is git-ignored — never commit real secrets.

# Django settings (read by config/settings.py via python-dotenv)
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ZeptoMail SMTP (create an SMTP token in ZeptoMail and verify the sender)
# Keep the console backend for local development; Render uses SMTP in render.yaml.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.zeptomail.com
EMAIL_PORT=587
EMAIL_HOST_USER=emailapikey
ZEPTOMAIL_SMTP_TOKEN=replace-with-your-zeptomail-smtp-token
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=The Nigerian Entrepreneur <noreply@thenigerianentrepreneur.com>
PUBLIC_SITE_URL=https://thenigerianentrepreneur.com

# Comma-separated inboxes notified when a payout is requested
ADMIN_NOTIFICATION_EMAILS=admin@thenigerianentrepreneur.com

# Daily post email automation defaults
LOW_POST_MIN_AGE_DAYS=7
LOW_POST_VIEW_THRESHOLD=100
HIGH_PERFORMANCE_VIEW_THRESHOLD=1000
EMAIL_AUTOMATION_TOKEN=replace-with-a-long-random-secret

# --- Production / Render -------------------------------------------------
# render.yaml sets DJANGO_DEBUG, DJANGO_SECRET_KEY (generated), DATABASE_URL
# and the Render hostname automatically; override only if you deploy by hand.
# DJANGO_DEBUG=0
# DJANGO_CSRF_TRUSTED_ORIGINS=https://your-site.onrender.com
# DATABASE_URL=postgres://user:pass@host:5432/dbname   # injected by Render
# MEDIA_ROOT=/opt/render/project/src/media             # persistent-disk path
# Optional superuser created/refreshed by `manage.py bootstrap_site`:
# DJANGO_SUPERUSER_USERNAME=admin
# DJANGO_SUPERUSER_PASSWORD=change-me
# DJANGO_SUPERUSER_EMAIL=admin@example.com
